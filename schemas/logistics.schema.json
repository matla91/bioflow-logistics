{
  "$defs": {
    "LogisticsActionResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "BUFFER",
            "EXPEDITE",
            "REROUTE"
          ],
          "title": "Action",
          "type": "string"
        },
        "delay_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Delay Risk",
          "type": "number"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "predicted_delay_min": {
          "minimum": 0,
          "title": "Predicted Delay Min",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "shipment_thermal_exposure_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Shipment Thermal Exposure Risk",
          "type": "number"
        },
        "success_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Success Probability",
          "type": "number"
        }
      },
      "required": [
        "action",
        "eligible",
        "success_probability",
        "predicted_delay_min",
        "delay_risk",
        "shipment_thermal_exposure_risk",
        "reason"
      ],
      "title": "LogisticsActionResult",
      "type": "object"
    },
    "LogisticsAssumptions": {
      "additionalProperties": false,
      "description": "Uncalibrated scenario coefficients, never provider facts or QA limits.",
      "properties": {
        "ambient_reference_band_c": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Ambient Reference Band C",
          "type": "array"
        },
        "assumed": {
          "const": true,
          "default": true,
          "title": "Assumed",
          "type": "boolean"
        },
        "baseline_min_samples": {
          "minimum": 2,
          "title": "Baseline Min Samples",
          "type": "integer"
        },
        "delay_threshold_min": {
          "minimum": 0,
          "title": "Delay Threshold Min",
          "type": "number"
        },
        "expedite_handling_factor": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Expedite Handling Factor",
          "type": "number"
        },
        "expedite_transport_factor": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Expedite Transport Factor",
          "type": "number"
        },
        "exposure_budget_degree_min": {
          "exclusiveMinimum": 0,
          "title": "Exposure Budget Degree Min",
          "type": "number"
        },
        "falling_discharge_min_per_m3_s_hour": {
          "minimum": 0,
          "title": "Falling Discharge Min Per M3 S Hour",
          "type": "number"
        },
        "falling_level_min_per_cm_hour": {
          "minimum": 0,
          "title": "Falling Level Min Per Cm Hour",
          "type": "number"
        },
        "handling_sd_min": {
          "minimum": 0,
          "title": "Handling Sd Min",
          "type": "number"
        },
        "max_rhine_age_min": {
          "exclusiveMinimum": 0,
          "title": "Max Rhine Age Min",
          "type": "number"
        },
        "max_traffic_age_min": {
          "exclusiveMinimum": 0,
          "title": "Max Traffic Age Min",
          "type": "number"
        },
        "max_weather_age_min": {
          "exclusiveMinimum": 0,
          "title": "Max Weather Age Min",
          "type": "number"
        },
        "n_runs": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "N Runs",
          "type": "integer"
        },
        "rain_min_per_mm": {
          "minimum": 0,
          "title": "Rain Min Per Mm",
          "type": "number"
        },
        "reroute_extra_handling_min": {
          "minimum": 0,
          "title": "Reroute Extra Handling Min",
          "type": "number"
        },
        "reroute_traffic_factor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reroute Traffic Factor",
          "type": "number"
        },
        "reroute_transport_min": {
          "exclusiveMinimum": 0,
          "title": "Reroute Transport Min",
          "type": "number"
        },
        "reroute_transport_sd_min": {
          "minimum": 0,
          "title": "Reroute Transport Sd Min",
          "type": "number"
        },
        "river_penalty_cap_min": {
          "minimum": 0,
          "title": "River Penalty Cap Min",
          "type": "number"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "traffic_min_per_positive_z": {
          "minimum": 0,
          "title": "Traffic Min Per Positive Z",
          "type": "number"
        },
        "traffic_z_cap": {
          "exclusiveMinimum": 0,
          "title": "Traffic Z Cap",
          "type": "number"
        },
        "transport_sd_min": {
          "minimum": 0,
          "title": "Transport Sd Min",
          "type": "number"
        },
        "trend_min_span_min": {
          "exclusiveMinimum": 0,
          "title": "Trend Min Span Min",
          "type": "number"
        },
        "trend_window_min": {
          "exclusiveMinimum": 0,
          "title": "Trend Window Min",
          "type": "number"
        },
        "wind_min_per_m_s": {
          "minimum": 0,
          "title": "Wind Min Per M S",
          "type": "number"
        },
        "wind_threshold_m_s": {
          "minimum": 0,
          "title": "Wind Threshold M S",
          "type": "number"
        }
      },
      "required": [
        "n_runs",
        "seed",
        "transport_sd_min",
        "handling_sd_min",
        "traffic_min_per_positive_z",
        "traffic_z_cap",
        "falling_level_min_per_cm_hour",
        "falling_discharge_min_per_m3_s_hour",
        "river_penalty_cap_min",
        "rain_min_per_mm",
        "wind_threshold_m_s",
        "wind_min_per_m_s",
        "delay_threshold_min",
        "ambient_reference_band_c",
        "exposure_budget_degree_min",
        "expedite_transport_factor",
        "expedite_handling_factor",
        "reroute_transport_min",
        "reroute_transport_sd_min",
        "reroute_extra_handling_min",
        "reroute_traffic_factor",
        "max_traffic_age_min",
        "max_rhine_age_min",
        "max_weather_age_min",
        "trend_window_min",
        "trend_min_span_min",
        "baseline_min_samples"
      ],
      "title": "LogisticsAssumptions",
      "type": "object"
    },
    "LogisticsFeatures": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "rhine": {
          "anyOf": [
            {
              "$ref": "#/$defs/RhineFeatures"
            },
            {
              "type": "null"
            }
          ]
        },
        "traffic": {
          "items": {
            "$ref": "#/$defs/TrafficFeature"
          },
          "title": "Traffic",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeatherFeatures"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "as_of",
        "traffic",
        "rhine",
        "weather",
        "warnings"
      ],
      "title": "LogisticsFeatures",
      "type": "object"
    },
    "ObservationSource": {
      "additionalProperties": false,
      "description": "Provenance for observed external data, never shipment/factory assumptions.",
      "properties": {
        "dataset": {
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "licence": {
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "real_data": {
          "const": true,
          "default": true,
          "title": "Real Data",
          "type": "boolean"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "dataset",
        "url",
        "retrieved_at",
        "licence"
      ],
      "title": "ObservationSource",
      "type": "object"
    },
    "RhineFeatures": {
      "additionalProperties": false,
      "properties": {
        "discharge_m3_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discharge M3 S"
        },
        "discharge_trend_m3_s_per_hour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discharge Trend M3 S Per Hour"
        },
        "level_masl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level Masl"
        },
        "level_trend_cm_per_hour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level Trend Cm Per Hour"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        }
      },
      "required": [
        "observed_at",
        "level_masl",
        "discharge_m3_s",
        "level_trend_cm_per_hour",
        "discharge_trend_m3_s_per_hour",
        "sample_count"
      ],
      "title": "RhineFeatures",
      "type": "object"
    },
    "RiskDriver": {
      "additionalProperties": false,
      "properties": {
        "estimated_delay_contribution_min": {
          "minimum": 0,
          "title": "Estimated Delay Contribution Min",
          "type": "number"
        },
        "evidence_kind": {
          "enum": [
            "observed",
            "assumed"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "estimated_delay_contribution_min",
        "explanation",
        "evidence_kind"
      ],
      "title": "RiskDriver",
      "type": "object"
    },
    "ShipmentState": {
      "additionalProperties": false,
      "description": "All fields are SIMULATED. Transport minutes exclude handling minutes.\n\nProtection autonomy is remaining whole-journey time until packaging protection\nis assumed to expire. BUFFER covers the factory deadline from assumed stock.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "handling_min": {
          "minimum": 0,
          "title": "Handling Min",
          "type": "number"
        },
        "planned_remaining_min": {
          "exclusiveMinimum": 0,
          "title": "Planned Remaining Min",
          "type": "number"
        },
        "prior_exposure_degree_min": {
          "default": 0,
          "minimum": 0,
          "title": "Prior Exposure Degree Min",
          "type": "number"
        },
        "protection_remaining_min": {
          "minimum": 0,
          "title": "Protection Remaining Min",
          "type": "number"
        },
        "route_mode": {
          "enum": [
            "river",
            "road"
          ],
          "title": "Route Mode",
          "type": "string"
        },
        "shipment_id": {
          "minLength": 1,
          "title": "Shipment Id",
          "type": "string"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "stock_available": {
          "minimum": 0,
          "title": "Stock Available",
          "type": "integer"
        },
        "stock_required": {
          "default": 1,
          "minimum": 1,
          "title": "Stock Required",
          "type": "integer"
        }
      },
      "required": [
        "shipment_id",
        "as_of",
        "deadline_at",
        "route_mode",
        "planned_remaining_min",
        "handling_min",
        "protection_remaining_min",
        "stock_available"
      ],
      "title": "ShipmentState",
      "type": "object"
    },
    "TrafficFeature": {
      "additionalProperties": false,
      "properties": {
        "baseline_mean": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Mean"
        },
        "baseline_sample_count": {
          "minimum": 0,
          "title": "Baseline Sample Count",
          "type": "integer"
        },
        "baseline_sd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Sd"
        },
        "interval_end": {
          "format": "date-time",
          "title": "Interval End",
          "type": "string"
        },
        "observed_count": {
          "minimum": 0,
          "title": "Observed Count",
          "type": "number"
        },
        "station_id": {
          "minLength": 1,
          "title": "Station Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "missing_baseline",
            "zero_variance"
          ],
          "title": "Status",
          "type": "string"
        },
        "z_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Z Score"
        }
      },
      "required": [
        "station_id",
        "interval_end",
        "observed_count",
        "baseline_mean",
        "baseline_sd",
        "baseline_sample_count",
        "z_score",
        "status"
      ],
      "title": "TrafficFeature",
      "type": "object"
    },
    "WeatherFeatures": {
      "additionalProperties": false,
      "properties": {
        "air_temperature_c": {
          "title": "Air Temperature C",
          "type": "number"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "precipitation_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precipitation Mm"
        },
        "relative_humidity_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Humidity Pct"
        },
        "temperature_trend_c_per_hour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature Trend C Per Hour"
        },
        "wind_speed_m_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wind Speed M S"
        }
      },
      "required": [
        "observed_at",
        "air_temperature_c",
        "precipitation_mm",
        "wind_speed_m_s",
        "relative_humidity_pct",
        "temperature_trend_c_per_hour"
      ],
      "title": "WeatherFeatures",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Probabilities are Monte Carlo frequencies under assumptions, not calibration.\n\npredicted_delay_min is mean lateness beyond the simulated deadline. delay_risk\nuses delay_threshold_min. Thermal risk is P(ambient degree-minute proxy exceeds\nits assumed budget), with no claim of actual product-temperature excursions.\nSuccess means factory lateness <= threshold AND exposure proxy <= budget;\nBUFFER instead needs sufficient stock, independent of the incoming lot's proxy.",
  "properties": {
    "action_success_probabilities": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "propertyNames": {
        "enum": [
          "BUFFER",
          "EXPEDITE",
          "REROUTE"
        ]
      },
      "title": "Action Success Probabilities",
      "type": "object"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/LogisticsActionResult"
      },
      "title": "Actions",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "assumptions": {
      "$ref": "#/$defs/LogisticsAssumptions"
    },
    "delay_risk": {
      "maximum": 1,
      "minimum": 0,
      "title": "Delay Risk",
      "type": "number"
    },
    "features": {
      "$ref": "#/$defs/LogisticsFeatures"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "main_risk_drivers": {
      "items": {
        "$ref": "#/$defs/RiskDriver"
      },
      "title": "Main Risk Drivers",
      "type": "array"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "predicted_delay_min": {
      "minimum": 0,
      "title": "Predicted Delay Min",
      "type": "number"
    },
    "real_data_sources": {
      "items": {
        "$ref": "#/$defs/ObservationSource"
      },
      "minItems": 1,
      "title": "Real Data Sources",
      "type": "array"
    },
    "shipment_id": {
      "minLength": 1,
      "title": "Shipment Id",
      "type": "string"
    },
    "simulated_shipment": {
      "$ref": "#/$defs/ShipmentState"
    },
    "thermal_exposure_risk": {
      "maximum": 1,
      "minimum": 0,
      "title": "Thermal Exposure Risk",
      "type": "number"
    }
  },
  "required": [
    "shipment_id",
    "as_of",
    "predicted_delay_min",
    "delay_risk",
    "thermal_exposure_risk",
    "action_success_probabilities",
    "actions",
    "main_risk_drivers",
    "features",
    "simulated_shipment",
    "assumptions",
    "real_data_sources",
    "limitations",
    "model"
  ],
  "title": "LogisticsResult",
  "type": "object"
}

  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable batch-linked result with separate stock, timing and product evidence.",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "assessment_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "assumptions": {
      "$ref": "#/$defs/BatchAnalysisProfile"
    },
    "batch_id": {
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "incoming_shipments": {
      "items": {
        "$ref": "#/$defs/IncomingShipmentResult"
      },
      "title": "Incoming Shipments",
      "type": "array"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "known_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Known At"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "product_temperature": {
      "items": {
        "$ref": "#/$defs/ProductTemperatureEvidence"
      },
      "title": "Product Temperature",
      "type": "array"
    },
    "production_readiness": {
      "$ref": "#/$defs/ProductionReadiness"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceSummary"
      },
      "title": "Provenance",
      "type": "array"
    },
    "real_data_sources": {
      "items": {
        "$ref": "#/$defs/ObservationSource"
      },
      "title": "Real Data Sources",
      "type": "array"
    },
    "recommendation": {
      "$ref": "#/$defs/BatchRecommendation"
    },
    "shipment_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Shipment Ids",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "dataset_id",
    "batch_id",
    "shipment_ids",
    "as_of",
    "known_at",
    "input_sha256",
    "model_version",
    "production_readiness",
    "incoming_shipments",
    "product_temperature",
    "recommendation",
    "provenance",
    "real_data_sources",
    "assumptions",
    "limitations"
  ],
  "title": "StoredBatchAssessment",
  "type": "object"
}

{
  "$defs": {
    "BatchAnalysisProfile": {
      "additionalProperties": false,
      "description": "Persisted, uncalibrated worker configuration; never inferred from case labels.",
      "properties": {
        "destination": {
          "default": "Basel production site",
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "expedite_available": {
          "default": true,
          "title": "Expedite Available",
          "type": "boolean"
        },
        "handling_min": {
          "default": 0,
          "minimum": 0,
          "title": "Handling Min",
          "type": "number"
        },
        "logistics": {
          "$ref": "#/$defs/LogisticsAssumptions"
        },
        "max_reading_gap_min": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Max Reading Gap Min",
          "type": "number"
        },
        "origin": {
          "default": "Rotterdam",
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "protection_remaining_min": {
          "default": 0,
          "minimum": 0,
          "title": "Protection Remaining Min",
          "type": "number"
        },
        "reroute_available": {
          "default": false,
          "title": "Reroute Available",
          "type": "boolean"
        },
        "station_ids": {
          "default": [
            "402"
          ],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Station Ids",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "logistics"
      ],
      "title": "BatchAnalysisProfile",
      "type": "object"
    },
    "BatchRecommendation": {
      "additionalProperties": false,
      "description": "Human approval is mandatory; no automatic QA disposition or release.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "enum": [
                "BUFFER",
                "EXPEDITE",
                "REROUTE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/LogisticsActionResult"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "qa_release_authorized": {
          "const": false,
          "default": false,
          "title": "Qa Release Authorized",
          "type": "boolean"
        },
        "qa_review_required": {
          "title": "Qa Review Required",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requires_approval_by": {
          "enum": [
            "operator",
            "logistics",
            "QA"
          ],
          "title": "Requires Approval By",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason",
        "requires_approval_by",
        "qa_review_required",
        "alternatives"
      ],
      "title": "BatchRecommendation",
      "type": "object"
    },
    "BatchStockEvidence": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "eligible_reserved_quantity_kg": {
          "minimum": 0,
          "title": "Eligible Reserved Quantity Kg",
          "type": "number"
        },
        "inventory_lot_id": {
          "minLength": 1,
          "title": "Inventory Lot Id",
          "type": "string"
        },
        "qa_status": {
          "enum": [
            "released",
            "pending",
            "quarantined"
          ],
          "title": "Qa Status",
          "type": "string"
        },
        "quantity_kg": {
          "minimum": 0,
          "title": "Quantity Kg",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reserved_for_batch_kg": {
          "minimum": 0,
          "title": "Reserved For Batch Kg",
          "type": "number"
        },
        "reserved_for_others_kg": {
          "minimum": 0,
          "title": "Reserved For Others Kg",
          "type": "number"
        },
        "unreserved_quantity_kg": {
          "minimum": 0,
          "title": "Unreserved Quantity Kg",
          "type": "number"
        }
      },
      "required": [
        "inventory_lot_id",
        "quantity_kg",
        "reserved_for_batch_kg",
        "reserved_for_others_kg",
        "unreserved_quantity_kg",
        "eligible_reserved_quantity_kg",
        "qa_status",
        "available_at",
        "reason"
      ],
      "title": "BatchStockEvidence",
      "type": "object"
    },
    "IncomingShipmentResult": {
      "additionalProperties": false,
      "description": "Arrival timing and ambient proxy stay separate from measured product evidence.",
      "properties": {
        "actual_arrival_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual Arrival At"
        },
        "cold_chain_exposure_proxy_risk": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cold Chain Exposure Proxy Risk"
        },
        "dependency_quantity_kg": {
          "minimum": 0,
          "title": "Dependency Quantity Kg",
          "type": "number"
        },
        "eta_p50": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Eta P50"
        },
        "eta_p90": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Eta P90"
        },
        "logistics": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogisticsResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "on_time_arrival_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "On Time Arrival Probability"
        },
        "planned_arrival_at": {
          "format": "date-time",
          "title": "Planned Arrival At",
          "type": "string"
        },
        "planned_quantity_kg": {
          "exclusiveMinimum": 0,
          "title": "Planned Quantity Kg",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "scheduled_after_charge": {
          "title": "Scheduled After Charge",
          "type": "boolean"
        },
        "shipment_id": {
          "minLength": 1,
          "title": "Shipment Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ARRIVED",
            "MODELED",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "shipment_id",
        "planned_quantity_kg",
        "dependency_quantity_kg",
        "planned_arrival_at",
        "actual_arrival_at",
        "scheduled_after_charge",
        "status",
        "on_time_arrival_probability",
        "eta_p50",
        "eta_p90",
        "cold_chain_exposure_proxy_risk",
        "logistics",
        "reason"
      ],
      "title": "IncomingShipmentResult",
      "type": "object"
    },
    "LogisticsActionResult": {
      "additionalProperties": false,
      "description": "Separate production timing, shipment timing and ambient exposure outcomes.\n\nArrival and production continuity use the exact deadline, without the legacy\ndelay tolerance. Factory timing is independent of ambient proxy exceedance;\nno pharmaceutical usability or QA release is inferred. BUFFER may cover the\nfactory while incoming arrival/exposure remain poor.",
      "properties": {
        "action": {
          "enum": [
            "BUFFER",
            "EXPEDITE",
            "REROUTE"
          ],
          "title": "Action",
          "type": "string"
        },
        "assessment": {
          "minLength": 1,
          "title": "Assessment",
          "type": "string"
        },
        "cold_chain_exposure_proxy_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cold Chain Exposure Proxy Risk",
          "type": "number"
        },
        "delay_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Delay Risk",
          "type": "number"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "on_time_arrival_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "On Time Arrival Probability",
          "type": "number"
        },
        "predicted_arrival_delay_min": {
          "minimum": 0,
          "title": "Predicted Arrival Delay Min",
          "type": "number"
        },
        "predicted_delay_min": {
          "minimum": 0,
          "title": "Predicted Delay Min",
          "type": "number"
        },
        "production_continuity_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Production Continuity Probability",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "success_probability": {
          "deprecated": true,
          "description": "DEPRECATED: BUFFER stock coverage, otherwise joint factory lateness <= tolerance and ambient proxy <= budget. Not comparable across actions; never used for recommendations.",
          "maximum": 1,
          "minimum": 0,
          "title": "Success Probability",
          "type": "number"
        }
      },
      "required": [
        "action",
        "eligible",
        "production_continuity_probability",
        "on_time_arrival_probability",
        "cold_chain_exposure_proxy_risk",
        "predicted_delay_min",
        "predicted_arrival_delay_min",
        "delay_risk",
        "assessment",
        "reason",
        "success_probability"
      ],
      "title": "LogisticsActionResult",
      "type": "object"
    },
    "LogisticsAssumptions": {
      "additionalProperties": false,
      "description": "Uncalibrated scenario coefficients, never provider facts or QA limits.",
      "properties": {
        "ambient_reference_band_c": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Ambient Reference Band C",
          "type": "array"
        },
        "assumed": {
          "const": true,
          "default": true,
          "title": "Assumed",
          "type": "boolean"
        },
        "baseline_min_samples": {
          "minimum": 2,
          "title": "Baseline Min Samples",
          "type": "integer"
        },
        "delay_threshold_min": {
          "minimum": 0,
          "title": "Delay Threshold Min",
          "type": "number"
        },
        "expedite_handling_factor": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Expedite Handling Factor",
          "type": "number"
        },
        "expedite_transport_factor": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Expedite Transport Factor",
          "type": "number"
        },
        "exposure_budget_degree_min": {
          "exclusiveMinimum": 0,
          "title": "Exposure Budget Degree Min",
          "type": "number"
        },
        "falling_discharge_min_per_m3_s_hour": {
          "minimum": 0,
          "title": "Falling Discharge Min Per M3 S Hour",
          "type": "number"
        },
        "falling_level_min_per_cm_hour": {
          "minimum": 0,
          "title": "Falling Level Min Per Cm Hour",
          "type": "number"
        },
        "handling_sd_min": {
          "minimum": 0,
          "title": "Handling Sd Min",
          "type": "number"
        },
        "max_rhine_age_min": {
          "exclusiveMinimum": 0,
          "title": "Max Rhine Age Min",
          "type": "number"
        },
        "max_traffic_age_min": {
          "exclusiveMinimum": 0,
          "title": "Max Traffic Age Min",
          "type": "number"
        },
        "max_weather_age_min": {
          "exclusiveMinimum": 0,
          "title": "Max Weather Age Min",
          "type": "number"
        },
        "n_runs": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "N Runs",
          "type": "integer"
        },
        "navigation_restricted_penalty_min": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Navigation Restricted Penalty Min",
          "type": "number"
        },
        "navigation_severe_penalty_min": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Navigation Severe Penalty Min",
          "type": "number"
        },
        "rain_min_per_mm": {
          "minimum": 0,
          "title": "Rain Min Per Mm",
          "type": "number"
        },
        "recommendation_policy": {
          "$ref": "#/$defs/RecommendationPolicy"
        },
        "reroute_extra_handling_min": {
          "minimum": 0,
          "title": "Reroute Extra Handling Min",
          "type": "number"
        },
        "reroute_traffic_factor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reroute Traffic Factor",
          "type": "number"
        },
        "reroute_transport_min": {
          "exclusiveMinimum": 0,
          "title": "Reroute Transport Min",
          "type": "number"
        },
        "reroute_transport_sd_min": {
          "minimum": 0,
          "title": "Reroute Transport Sd Min",
          "type": "number"
        },
        "river_penalty_cap_min": {
          "minimum": 0,
          "title": "River Penalty Cap Min",
          "type": "number"
        },
        "route_block_delay_min": {
          "default": 1440,
          "exclusiveMinimum": 0,
          "title": "Route Block Delay Min",
          "type": "number"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "traffic_min_per_positive_z": {
          "minimum": 0,
          "title": "Traffic Min Per Positive Z",
          "type": "number"
        },
        "traffic_z_cap": {
          "exclusiveMinimum": 0,
          "title": "Traffic Z Cap",
          "type": "number"
        },
        "transport_sd_min": {
          "minimum": 0,
          "title": "Transport Sd Min",
          "type": "number"
        },
        "trend_min_span_min": {
          "exclusiveMinimum": 0,
          "title": "Trend Min Span Min",
          "type": "number"
        },
        "trend_window_min": {
          "exclusiveMinimum": 0,
          "title": "Trend Window Min",
          "type": "number"
        },
        "wind_min_per_m_s": {
          "minimum": 0,
          "title": "Wind Min Per M S",
          "type": "number"
        },
        "wind_threshold_m_s": {
          "minimum": 0,
          "title": "Wind Threshold M S",
          "type": "number"
        }
      },
      "required": [
        "n_runs",
        "seed",
        "transport_sd_min",
        "handling_sd_min",
        "traffic_min_per_positive_z",
        "traffic_z_cap",
        "falling_level_min_per_cm_hour",
        "falling_discharge_min_per_m3_s_hour",
        "river_penalty_cap_min",
        "rain_min_per_mm",
        "wind_threshold_m_s",
        "wind_min_per_m_s",
        "delay_threshold_min",
        "ambient_reference_band_c",
        "exposure_budget_degree_min",
        "expedite_transport_factor",
        "expedite_handling_factor",
        "reroute_transport_min",
        "reroute_transport_sd_min",
        "reroute_extra_handling_min",
        "reroute_traffic_factor",
        "max_traffic_age_min",
        "max_rhine_age_min",
        "max_weather_age_min",
        "trend_window_min",
        "trend_min_span_min",
        "baseline_min_samples"
      ],
      "title": "LogisticsAssumptions",

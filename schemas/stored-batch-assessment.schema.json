    },
    "LogisticsFeatures": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "official_navigation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OfficialNavigationSignal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rhine": {
          "anyOf": [
            {
              "$ref": "#/$defs/RhineFeatures"
            },
            {
              "type": "null"
            }
          ]
        },
        "traffic": {
          "items": {
            "$ref": "#/$defs/TrafficFeature"
          },
          "title": "Traffic",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/WeatherFeatures"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "as_of",
        "traffic",
        "rhine",
        "weather",
        "warnings"
      ],
      "title": "LogisticsFeatures",
      "type": "object"
    },
    "LogisticsResult": {
      "additionalProperties": false,
      "description": "Probabilities are Monte Carlo frequencies under assumptions, not calibration.\n\npredicted_delay_min is mean lateness beyond the simulated deadline. delay_risk\nuses delay_threshold_min. Proxy risk is P(ambient degree-minute proxy exceeds\nits assumed budget), with no claim of actual product-temperature excursions.\nSuccess means factory lateness <= threshold AND exposure proxy <= budget;\nBUFFER instead needs sufficient stock, independent of the incoming lot's proxy.",
      "properties": {
        "action_success_probabilities": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "deprecated": true,
          "description": "DEPRECATED: action-specific legacy success events; do not compare or use for recommendations.",
          "propertyNames": {
            "enum": [
              "BUFFER",
              "EXPEDITE",
              "REROUTE"
            ]
          },
          "title": "Action Success Probabilities",
          "type": "object"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/LogisticsActionResult"
          },
          "title": "Actions",
          "type": "array"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "assumptions": {
          "$ref": "#/$defs/LogisticsAssumptions"
        },
        "cold_chain_exposure_proxy_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cold Chain Exposure Proxy Risk",
          "type": "number"
        },
        "data_provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/ProvenanceSummary"
          },
          "title": "Data Provenance",
          "type": "object"
        },
        "delay_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Delay Risk",
          "type": "number"
        },
        "features": {
          "$ref": "#/$defs/LogisticsFeatures"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "main_risk_drivers": {
          "items": {
            "$ref": "#/$defs/RiskDriver"
          },
          "title": "Main Risk Drivers",
          "type": "array"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "navigation": {
          "$ref": "#/$defs/NavigationAssessment"
        },
        "predicted_delay_min": {
          "minimum": 0,
          "title": "Predicted Delay Min",
          "type": "number"
        },
        "real_data_sources": {
          "items": {
            "$ref": "#/$defs/ObservationSource"
          },
          "minItems": 1,
          "title": "Real Data Sources",
          "type": "array"
        },
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "shipment_id": {
          "minLength": 1,
          "title": "Shipment Id",
          "type": "string"
        },
        "simulated_shipment": {
          "$ref": "#/$defs/ShipmentState"
        }
      },
      "required": [
        "shipment_id",
        "as_of",
        "predicted_delay_min",
        "delay_risk",
        "cold_chain_exposure_proxy_risk",
        "action_success_probabilities",
        "actions",
        "navigation",
        "recommendation",
        "data_provenance",
        "main_risk_drivers",
        "features",
        "simulated_shipment",
        "assumptions",
        "real_data_sources",
        "limitations",
        "model"
      ],
      "title": "LogisticsResult",
      "type": "object"
    },
    "NavigationAssessment": {
      "additionalProperties": false,
      "description": "Official state if supplied and valid; otherwise an ASSUMED trend scenario.\n\nDelay provenance is independent of status provenance. No state implies an\nofficial hydrological threshold or navigation restriction without an adapter.",
      "properties": {
        "delay_kind": {
          "enum": [
            "REAL",
            "OFFICIAL_FORECAST",
            "MODEL",
            "SIMULATED",
            "ASSUMED"
          ],
          "title": "Delay Kind",
          "type": "string"
        },
        "delay_penalty_min": {
          "minimum": 0,
          "title": "Delay Penalty Min",
          "type": "number"
        },
        "kind": {
          "enum": [
            "REAL",
            "OFFICIAL_FORECAST",
            "MODEL",
            "SIMULATED",
            "ASSUMED"
          ],
          "title": "Kind",
          "type": "string"
        },
        "normal_route_eligible": {
          "title": "Normal Route Eligible",
          "type": "boolean"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reported_delay_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Delay Min"
        },
        "state": {
          "enum": [
            "NORMAL",
            "WATCH",
            "RESTRICTED",
            "SEVERE",
            "UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "state",
        "kind",
        "normal_route_eligible",
        "delay_penalty_min",
        "delay_kind",
        "reason"
      ],
      "title": "NavigationAssessment",
      "type": "object"
    },
    "ObservationSource": {
      "additionalProperties": false,
      "description": "Provenance for observed external data, never shipment/factory assumptions.",
      "properties": {
        "dataset": {
